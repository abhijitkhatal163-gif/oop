#include <iostream>
using namespace std;

void accept(int &n, int arr[])
{
cout << "Enter number of elements: ";
cin >> n;

cout << "Enter array elements:\n";

for (int i = 0; i < n; i++)

{
cin >> arr[i];
}
}

void display(int n, int arr[])
{
for (int i = 0; i < n; i++)
{
cout << arr[i] << " ";
}
}

void sortArray(int n, int arr[])
{
for (int i = 0; i < n - 1; i++)
{
for (int j = 0; j < n - 1 - i; j++)
{
if (arr[j] > arr[j + 1])
{

int temp = arr[j];
arr[j] = arr[j + 1];
arr[j + 1] = temp;

}
}
}
}

int main()
{
int n;
int arr[10];

accept(n, arr);

cout << "\nUnsorted array: ";
display(n, arr);

sortArray(n, arr);

cout << "\nSorted array: ";
display(n, arr);

return 0;
}